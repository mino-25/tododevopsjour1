{
  "title": "Todo API - Golden Signals",
  "uid": "todo-api-golden-signals",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Disponibilite (up)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "up{job=\"todo-api\"}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Trafic (requetes/s)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_requests_total{job=\"todo-api\"}[1m]))", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Erreurs (taux 5xx)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"todo-api\",status_code=~\"5..\"}[1m])) / sum(rate(http_requests_total{job=\"todo-api\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Latence p95 (s)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"todo-api\"}[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Taches creees (total)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 6 },
      "targets": [
        { "expr": "todo_tasks_created_total", "refId": "A" }
      ]
    }
  ]
}
